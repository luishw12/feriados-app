{
  "name": "feriados-brasil",
  "type": "module",
  "version": "2.3.0-beta",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luishw12/feriados-app.git"
  },
  "bugs": {
    "url": "https://github.com/luishw12/feriados-app/issues"
  },
  "homepage": "https://feriados.luishw.com.br",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run db:setup && astro dev",
    "build": "npm run db:setup && npm run db:setup -- --local && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --experimental-strip-types scripts/db-migrate.ts",
    "db:seed": "node --experimental-strip-types scripts/db-seed.ts",
    "db:setup": "node --experimental-strip-types scripts/db-setup.ts",
    "db:export": "node --experimental-strip-types scripts/db-export.ts",
    "changelog:sync": "node scripts/sync-changelog.mjs",
    "release:check": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "@astrojs/preact": "^6.0.5",
    "@astrojs/vercel": "^11.0.11",
    "@libsql/client": "^0.18.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/functions": "^3.9.9",
    "astro": "^7.3.5",
    "drizzle-orm": "^0.45.3",
    "preact": "^10.29.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.63.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
