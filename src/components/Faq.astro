---
import Icon from './Icon.astro';
import type { FaqItem } from '@/lib/pages';

interface Props {
  items: FaqItem[];
  title?: string;
}

const { items, title = 'Perguntas frequentes' } = Astro.props;
---

{
  items.length > 0 && (
    <section aria-labelledby="faq" class="mt-16">
      <h2 id="faq" class="text-2xl font-bold tracking-tight sm:text-[28px]">
        {title}
      </h2>
      <div class="mt-4 flex flex-col gap-2.5">
        {items.map((item, i) => (
          <details class="group rounded-2xl border border-line bg-surface" open={i === 0}>
            <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 px-4 py-3 text-base font-semibold sm:px-5 sm:text-[17px] [&::-webkit-details-marker]:hidden">
              <h3>{item.q}</h3>
              <Icon name="chevronDown" size={20} class="text-faint transition-transform group-open:rotate-180" />
            </summary>
            <p class="px-4 pb-4 text-base leading-relaxed text-muted sm:px-5">{item.a}</p>
          </details>
        ))}
      </div>
    </section>
  )
}
