---
import { AUTHOR_STACK, getAuthorInitials } from '@/lib/about-content';

interface Props {
  authorName: string;
  linkedinUrl: string;
  githubUrl: string;
}

const { authorName, linkedinUrl, githubUrl } = Astro.props;
const initials = getAuthorInitials(authorName);
---

<section
  class="rounded-2xl border border-neutral-200/90 bg-white/50 p-6 sm:p-8 dark:border-neutral-800 dark:bg-neutral-950/40"
  aria-labelledby="about-author-heading"
>
  <div class="flex flex-col gap-8 lg:flex-row lg:items-start lg:justify-between lg:gap-12">
    <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:gap-5">
      <div
        class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-lg font-semibold text-white dark:bg-emerald-500 dark:text-neutral-950"
        aria-hidden="true"
      >
        {initials}
      </div>
      <div class="space-y-3">
        <div class="space-y-1">
          <p class="text-xs font-medium uppercase tracking-[0.14em] text-neutral-500 dark:text-neutral-400">
            Mantenedor
          </p>
          <h2
            id="about-author-heading"
            class="text-xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-50"
          >
            {authorName}
          </h2>
        </div>
        <p class="max-w-xl text-sm leading-relaxed text-neutral-600 dark:text-neutral-400 sm:text-base">
          Projeto open source criado como portfólio técnico: Astro com React islands, Tailwind CSS
          e TypeScript. HTML estático, Core Web Vitals sólidos e SEO orgânico — sem backend e sem
          API em runtime.
        </p>
        <ul class="flex flex-wrap gap-2" aria-label="Stack técnica">
          {
            AUTHOR_STACK.map((tech) => (
              <li>
                <span class="inline-flex rounded-md border border-neutral-200/80 bg-white/60 px-2.5 py-1 text-xs font-medium text-neutral-600 dark:border-neutral-800 dark:bg-neutral-900/50 dark:text-neutral-300">
                  {tech}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="flex shrink-0 flex-wrap gap-3 lg:flex-col lg:items-stretch">
      <a
        href={linkedinUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 rounded-full bg-[#0A66C2] px-5 py-2.5 text-sm font-medium text-white transition-colors duration-150 hover:bg-[#004182] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0A66C2]"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 114.126 0 2.063 2.063 0 01-2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
          ></path>
        </svg>
        LinkedIn
      </a>
      <a
        href={githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center rounded-full border border-neutral-200/90 px-5 py-2.5 text-sm font-medium text-neutral-700 transition-colors duration-150 hover:border-emerald-300 hover:text-emerald-700 dark:border-neutral-800 dark:text-neutral-300 dark:hover:border-emerald-700 dark:hover:text-emerald-300"
      >
        GitHub
      </a>
    </div>
  </div>
</section>
