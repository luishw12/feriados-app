---
interface GuideItem {
  href: string;
  title: string;
  description: string;
}

interface Props {
  items: GuideItem[];
  year: number;
}

const { items, year } = Astro.props;
---

<section class="space-y-6" aria-labelledby="guide-index-heading">
  <div class="flex items-end justify-between gap-4">
    <div class="space-y-1">
      <h2
        id="guide-index-heading"
        class="text-xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-50"
      >
        Índice de guias
      </h2>
      <p class="text-sm text-neutral-500 dark:text-neutral-400">
        Escolha um tema para ver datas, regras e exemplos de {year}.
      </p>
    </div>
    <p class="shrink-0 text-sm tabular-nums text-neutral-400 dark:text-neutral-500">
      {items.length} temas
    </p>
  </div>

  <ol class="divide-y divide-neutral-200/80 border-y border-neutral-200/80 dark:divide-neutral-800 dark:border-neutral-800">
    {
      items.map((guide, index) => (
        <li>
          <a
            href={guide.href}
            class="group grid grid-cols-[auto_1fr_auto] items-start gap-4 py-5 transition-colors duration-150 sm:gap-6 sm:py-6"
          >
            <span
              class="pt-0.5 text-sm font-medium tabular-nums text-neutral-400 transition-colors duration-150 group-hover:text-emerald-600 dark:text-neutral-500 dark:group-hover:text-emerald-400"
              aria-hidden="true"
            >
              {String(index + 1).padStart(2, '0')}
            </span>
            <span class="min-w-0 space-y-1">
              <span class="block font-medium text-neutral-900 transition-colors duration-150 group-hover:text-emerald-700 dark:text-neutral-50 dark:group-hover:text-emerald-300">
                {guide.title}
              </span>
              <span class="block text-sm leading-relaxed text-neutral-500 dark:text-neutral-400">
                {guide.description}
              </span>
            </span>
            <span
              class="pt-0.5 text-neutral-300 transition-all duration-150 group-hover:translate-x-0.5 group-hover:text-emerald-600 dark:text-neutral-600 dark:group-hover:text-emerald-400"
              aria-hidden="true"
            >
              →
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</section>
