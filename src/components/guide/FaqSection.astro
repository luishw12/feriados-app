---
import type { FaqItem } from '@/lib/llms';

interface Props {
  items: FaqItem[];
  title?: string;
}

const { items, title = 'Perguntas frequentes' } = Astro.props;
---

<section class="space-y-6" aria-label={title}>
  <div class="space-y-1">
    <h2 class="text-xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-50">
      {title}
    </h2>
    <p class="text-sm text-neutral-500 dark:text-neutral-400">
      Respostas curtas para as dúvidas mais buscadas.
    </p>
  </div>

  <div class="divide-y divide-neutral-200/80 border-y border-neutral-200/80 dark:divide-neutral-800 dark:border-neutral-800">
    {
      items.map((faq) => (
        <details class="group py-1">
          <summary class="flex cursor-pointer list-none items-start justify-between gap-4 py-4 text-left marker:content-none [&::-webkit-details-marker]:hidden">
            <span class="font-medium text-neutral-900 transition-colors duration-150 group-open:text-emerald-700 dark:text-neutral-50 dark:group-open:text-emerald-300">
              {faq.question}
            </span>
            <span
              class="mt-0.5 shrink-0 text-neutral-400 transition-transform duration-200 group-open:rotate-45 dark:text-neutral-500"
              aria-hidden="true"
            >
              +
            </span>
          </summary>
          <p class="pb-5 pr-8 text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">
            {faq.answer}
          </p>
        </details>
      ))
    }
  </div>
</section>
