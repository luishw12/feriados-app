---
import '@/styles/global.css';
import { count, eq } from 'drizzle-orm';
import Icon, { type IconName } from '@/components/Icon.astro';
import { initials } from '@/lib/admin-ui';
import { getDb, isReadOnly, schema } from '@/lib/db/client';

interface Props {
  title: string;
  active?: 'sugestoes' | 'feriados' | 'historico';
}

const { title, active } = Astro.props;
const admin = Astro.locals.admin;
const [pending] = admin
  ? await getDb().select({ n: count() }).from(schema.suggestions).where(eq(schema.suggestions.status, 'pending'))
  : [{ n: 0 }];
const sections: { label: string; items: { key: Props['active']; href: string; label: string; icon: IconName; badge: number }[] }[] = [
  { label: 'Moderação', items: [{ key: 'sugestoes', href: '/admin/sugestoes/', label: 'Sugestões', icon: 'inbox', badge: pending?.n ?? 0 }] },
  {
    label: 'Dados',
    items: [
      { key: 'feriados', href: '/admin/feriados/', label: 'Feriados', icon: 'calendar', badge: 0 },
      { key: 'historico', href: '/admin/historico/', label: 'Histórico', icon: 'history', badge: 0 },
    ],
  },
];
const itemClass = 'flex h-10 shrink-0 items-center gap-3 rounded-xl px-2.5 text-sm whitespace-nowrap transition-colors';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Painel Feriados Brasil</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        document.documentElement.classList.toggle('dark', t ? t === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches);
      } catch {}
    </script>
  </head>
  <body class="min-h-dvh lg:flex">
    {
      admin && (
        <aside class="sticky top-0 z-20 flex shrink-0 flex-col gap-3 border-b border-line bg-surface/90 px-3 py-3 backdrop-blur lg:h-dvh lg:w-64 lg:gap-7 lg:border-r lg:border-b-0 lg:px-3.5 lg:py-5">
          <div class="flex items-center gap-3">
            <a href="/admin/" class="flex min-w-0 flex-1 items-center gap-3 rounded-xl px-2 py-1">
              <span class="flex size-9 shrink-0 items-center justify-center rounded-[10px] border border-brand/25 bg-brand/12 text-brand">
                <Icon name="calendar" size={18} />
              </span>
              <span class="flex min-w-0 flex-col leading-tight">
                <span class="truncate font-semibold tracking-tight">Feriados Brasil</span>
                <span class="text-xs text-faint">Painel de moderação</span>
              </span>
            </a>
            <form method="post" action="/admin/auth/logout/" class="lg:hidden">
              <button class="btn size-10 px-0" aria-label="Sair" title="Sair">
                <Icon name="logOut" />
              </button>
            </form>
          </div>

          <nav aria-label="Painel" class="-mx-3 flex gap-1 overflow-x-auto px-3 lg:mx-0 lg:flex-1 lg:flex-col lg:gap-5 lg:overflow-visible lg:px-0">
            {
              sections.map((s) => (
                <div class="flex gap-1 lg:flex-col lg:gap-0.5">
                  <p class="eyebrow hidden px-2.5 pb-1.5 lg:block">{s.label}</p>
                  {s.items.map((n) => (
                    <a
                      href={n.href}
                      aria-current={active === n.key ? 'page' : undefined}
                      class:list={[
                        itemClass,
                        active === n.key ? 'bg-subtle font-semibold text-fg ring-1 ring-inset ring-line' : 'text-muted hover:bg-subtle hover:text-fg',
                      ]}
                    >
                      <Icon name={n.icon} size={18} class={active === n.key ? 'text-brand' : 'text-faint'} />
                      <span class="lg:flex-1">{n.label}</span>
                      {n.badge > 0 && (
                        <span class="tabular flex h-5.5 min-w-5.5 items-center justify-center rounded-full bg-brand px-1.5 text-xs font-bold text-brand-fg">
                          {n.badge}
                        </span>
                      )}
                    </a>
                  ))}
                </div>
              ))
            }
            <div class="flex gap-1 lg:flex-col lg:gap-0.5">
              <p class="eyebrow hidden px-2.5 pb-1.5 lg:block">Atalhos</p>
              <a href="/admin/feriados/novo/" class:list={[itemClass, 'text-muted hover:bg-subtle hover:text-fg']}>
                <Icon name="plus" size={18} class="text-faint" />
                <span class="lg:flex-1">Novo feriado</span>
              </a>
              <a href="/" class:list={[itemClass, 'text-muted hover:bg-subtle hover:text-fg']}>
                <Icon name="globe" size={18} class="text-faint" />
                <span class="lg:flex-1">Ver site</span>
                <Icon name="external" size={14} class="hidden text-faint lg:block" />
              </a>
            </div>
          </nav>

          <div class="hidden items-center gap-2.5 rounded-2xl border border-line bg-bg p-2.5 lg:flex">
            {admin.avatarUrl ? (
              <img src={admin.avatarUrl} alt="" width="36" height="36" class="size-9 shrink-0 rounded-full" />
            ) : (
              <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-national-soft text-xs font-bold text-national">
                {initials(admin.name)}
              </span>
            )}
            <span class="flex min-w-0 flex-1 flex-col leading-tight">
              <span class="truncate text-sm font-semibold">{admin.name}</span>
              <span class="truncate text-xs text-faint">@{admin.login}</span>
            </span>
            <form method="post" action="/admin/auth/logout/">
              <button class="flex size-9 items-center justify-center rounded-xl border border-line text-muted transition-colors hover:bg-subtle hover:text-fg" aria-label="Sair" title="Sair">
                <Icon name="logOut" />
              </button>
            </form>
          </div>
        </aside>
      )
    }
    <div class="min-w-0 flex-1">
      {
        isReadOnly && (
          <p class="bg-warn-soft px-4 py-2 text-center text-sm text-warn">
            Banco em modo somente leitura (TURSO_DATABASE_URL não configurado). Alterações não serão salvas.
          </p>
        )
      }
      <main class="mx-auto max-w-6xl px-4 py-8 sm:px-8 lg:py-10">
        <slot />
      </main>
    </div>
  </body>
</html>
