---
import { CATEGORIES, KINDS, SCOPES, STATUSES } from '@/lib/db/schema';
import type { HolidayForm } from '@/lib/server/moderation';
import { getStates } from '@/lib/data';
import { KIND_LABEL, SCOPE_LABEL, STATUS_LABEL } from '@/lib/site';

interface Props {
  value: HolidayForm;
  /** ID editável só na criação. */
  idEditable: boolean;
}

const { value, idEditable } = Astro.props;
const states = await getStates();
const label = 'block text-xs font-medium text-muted mb-1';
---

<div class="grid gap-4 sm:grid-cols-6">
  <label class="sm:col-span-4">
    <span class={label}>Nome</span>
    <input name="name" class="input" value={value.name} required maxlength="120" />
  </label>
  <label class="sm:col-span-2">
    <span class={label}>Status</span>
    <select name="status" class="input">
      {STATUSES.map((s) => <option value={s} selected={value.status === s}>{STATUS_LABEL[s]}</option>)}
    </select>
  </label>
  <label class="sm:col-span-3">
    <span class={label}>ID (URL /feriado/…/)</span>
    <input name="id" class="input font-mono" value={value.id} readonly={!idEditable} required pattern="[a-z0-9-]+" />
  </label>
  <label class="sm:col-span-3">
    <span class={label}>Regra da data</span>
    <input name="rule" class="input font-mono" value={value.rule} required list="rules" placeholder="fixed:MM-DD" />
    <datalist id="rules">
      <option value="easter:-48">Segunda de Carnaval</option>
      <option value="easter:-47">Carnaval</option>
      <option value="easter:-46">Quarta de Cinzas</option>
      <option value="easter:-2">Sexta-feira Santa</option>
      <option value="easter:+60">Corpus Christi</option>
    </datalist>
    <span class="mt-1 block text-xs text-faint">fixed:MM-DD · easter:±N · nth:MM:DOW:N · last:MM:DOW</span>
  </label>
  <label class="sm:col-span-2">
    <span class={label}>Abrangência</span>
    <select name="scope" class="input">
      {SCOPES.map((s) => <option value={s} selected={value.scope === s}>{SCOPE_LABEL[s]}</option>)}
    </select>
  </label>
  <label class="sm:col-span-1">
    <span class={label}>UF</span>
    <select name="uf" class="input">
      <option value="">—</option>
      {states.map((s) => <option value={s.uf} selected={value.uf === s.uf}>{s.uf}</option>)}
    </select>
  </label>
  <label class="sm:col-span-1">
    <span class={label}>IBGE</span>
    <input name="ibge" class="input font-mono" value={value.ibge ?? ''} inputmode="numeric" pattern="\d{7}" />
  </label>
  <label class="sm:col-span-2">
    <span class={label}>Tipo</span>
    <select name="kind" class="input">
      {KINDS.map((k) => <option value={k} selected={value.kind === k}>{KIND_LABEL[k]}</option>)}
    </select>
  </label>
  <label class="sm:col-span-3">
    <span class={label}>Base legal</span>
    <input name="legalBasis" class="input" value={value.legalBasis} maxlength="300" placeholder="Lei municipal nº …" />
  </label>
  <label class="sm:col-span-3">
    <span class={label}>Fonte (link)</span>
    <input name="sourceUrl" type="url" class="input" value={value.sourceUrl} placeholder="https://" />
  </label>
  <label class="sm:col-span-6">
    <span class={label}>Resumo (1 frase, aparece nas listas)</span>
    <input name="summary" class="input" value={value.summary} maxlength="300" />
  </label>
  <label class="sm:col-span-6">
    <span class={label}>Texto da página (Markdown simples: parágrafos, **negrito**, [link](https://…), listas com “- ”)</span>
    <textarea name="body" class="input min-h-32 font-mono text-xs" maxlength="8000">{value.body}</textarea>
  </label>
  <fieldset class="sm:col-span-4">
    <legend class={label}>Categorias</legend>
    <div class="flex flex-wrap gap-3 text-sm">
      {
        CATEGORIES.map((c) => (
          <label class="flex items-center gap-1.5">
            <input type="checkbox" name="categories" value={c} checked={value.categories.includes(c)} /> {c}
          </label>
        ))
      }
    </div>
  </fieldset>
  <label class="sm:col-span-1">
    <span class={label}>Vale desde</span>
    <input name="validFrom" class="input" value={value.validFrom ?? ''} inputmode="numeric" placeholder="ano" />
  </label>
  <label class="sm:col-span-1">
    <span class={label}>Vale até</span>
    <input name="validTo" class="input" value={value.validTo ?? ''} inputmode="numeric" placeholder="ano" />
  </label>
</div>
