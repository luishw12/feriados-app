---
const items = [
  ['national', 'Feriado nacional'],
  ['state', 'Feriado estadual'],
  ['municipal', 'Feriado municipal'],
  ['optional', 'Ponto facultativo'],
  ['commemorative', 'Data comemorativa'],
] as const;
---

<ul class="flex flex-wrap gap-x-4 gap-y-1.5 text-xs text-muted" aria-label="Legenda">
  {
    items.map(([t, label]) => (
      <li class={`tone-${t} flex items-center gap-1.5`}>
        <span class="tone-dot size-2 rounded-full" aria-hidden="true" />
        {label}
      </li>
    ))
  }
</ul>
