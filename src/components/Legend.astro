---
interface Props {
  /** `inline`: bolinhas lado a lado; `card`: lista com explicação de cada tipo. */
  variant?: 'inline' | 'card';
}

const { variant = 'inline' } = Astro.props;
const items = [
  ['national', 'Feriado nacional', 'Folga em todo o país.'],
  ['state', 'Feriado estadual', 'Vale só no estado.'],
  ['municipal', 'Feriado municipal', 'Vale só na cidade.'],
  ['optional', 'Ponto facultativo', 'Cada empregador decide se dá folga.'],
  ['commemorative', 'Data comemorativa', 'Não é feriado, sem folga prevista em lei.'],
] as const;
---

{
  variant === 'card' ? (
    <ul class="mt-3.5 flex flex-col gap-3 text-[15px]" aria-label="Legenda">
      {items.map(([t, label, hint]) => (
        <li class={`tone-${t} flex gap-2.5`}>
          <span class="tone-dot mt-[5px] size-3 shrink-0 rounded" aria-hidden="true" />
          <span>
            <strong class="font-semibold">{label}</strong>
            <span class="block text-muted">{hint}</span>
          </span>
        </li>
      ))}
    </ul>
  ) : (
    <ul class="flex flex-wrap gap-x-4 gap-y-1.5 text-[13px] text-muted" aria-label="Legenda">
      {items.map(([t, label]) => (
        <li class={`tone-${t} flex items-center gap-1.5`}>
          <span class="tone-dot size-2.5 rounded-[3px]" aria-hidden="true" />
          {label}
        </li>
      ))}
    </ul>
  )
}
