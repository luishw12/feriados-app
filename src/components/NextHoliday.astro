---
import DateTile from './DateTile.astro';
import Icon from './Icon.astro';
import WeekStrip from './WeekStrip.astro';
import type { Occurrence } from '@/lib/holidays/resolve';
import { diffDays, formatLong } from '@/lib/holidays/rules';
import { countdownText, paths, tone, typeLabel } from '@/lib/site';

interface Props {
  next: Occurrence;
  today: string;
  label?: string;
}

const { next, today, label = 'Próximo feriado' } = Astro.props;
const days = diffDays(today, next.date);
const t = tone(next.scope, next.kind);
const href = paths.holiday(next.id, Number(next.date.slice(0, 4)));
---

<div class="card relative flex flex-col gap-5 p-5 shadow-[var(--shadow-raised)] transition-colors hover:border-line-strong sm:p-7">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <p class="eyebrow">{label}</p>
    <p class="tabular rounded-full bg-brand-soft px-3 py-1 text-sm font-bold text-brand-strong" data-countdown={next.date}>{countdownText(days)}</p>
  </div>
  <div class="flex items-center gap-4 sm:gap-5">
    <DateTile date={next.date} tone={t} size="md" />
    <div class="min-w-0">
      <p class="text-xl leading-tight font-bold tracking-tight text-balance sm:text-[26px]">
        <a href={href} class="after:absolute after:inset-0 after:rounded-[var(--radius-card)]">{next.name}</a>
      </p>
      <p class="mt-1 text-[15px] text-muted sm:text-base"><time datetime={next.date}>{formatLong(next.date)}</time></p>
      <p class:list={[`tone-${t}`, 'chip tone-badge mt-2 text-[13px] font-semibold']}>{typeLabel(next.scope, next.kind)}</p>
    </div>
  </div>
  {next.kind === 'feriado' && <WeekStrip date={next.date} tone={t} />}
  <p class="flex items-center gap-1.5 text-[15px] font-semibold text-brand" aria-hidden="true">
    Ver detalhes do feriado <Icon name="arrowRight" />
  </p>
</div>
