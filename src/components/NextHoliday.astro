---
import Icon from './Icon.astro';
import type { Occurrence } from '@/lib/holidays/resolve';
import { diffDays, formatLong } from '@/lib/holidays/rules';
import { bridgeSentence, isBridge } from '@/lib/pages';
import { paths, tone, typeLabel } from '@/lib/site';

interface Props {
  next: Occurrence;
  today: string;
  label?: string;
}

const { next, today, label = 'Próximo feriado' } = Astro.props;
const days = diffDays(today, next.date);
const bridge = isBridge(next);
const t = tone(next.scope, next.kind);
---

<a
  href={paths.holiday(next.id, Number(next.date.slice(0, 4)))}
  class:list={[`tone-${t}`, 'card group block overflow-hidden p-5 transition-colors hover:border-line-strong sm:p-6']}
>
  <div class="flex items-start justify-between gap-4">
    <div class="min-w-0">
      <p class="eyebrow flex items-center gap-1.5"><Icon name="calendar" size={14} /> {label}</p>
      <p class="mt-2 text-2xl font-semibold tracking-tight sm:text-3xl">{next.name}</p>
      <p class="mt-1 text-muted">
        <time datetime={next.date}>{formatLong(next.date)}</time> · <span class="tone-text font-medium">{typeLabel(next.scope, next.kind)}</span>
      </p>
      {bridge && <p class="mt-3 text-sm text-muted">{bridgeSentence(bridge)}</p>}
    </div>
    <div class="shrink-0 text-right">
      <p class="tabular text-4xl font-semibold tracking-tight sm:text-5xl" data-days-until={next.date}>{days}</p>
      <p class="text-sm text-faint" data-days-label={next.date}>{days === 1 ? 'dia' : 'dias'}</p>
    </div>
  </div>
</a>

<script is:inline>
  // Recalcula "faltam N dias" no navegador: o HTML pode ter vindo do cache do CDN.
  (() => {
    const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Sao_Paulo' }).format(new Date());
    const t = Date.parse(today + 'T00:00:00Z');
    document.querySelectorAll('[data-days-until]').forEach((el) => {
      const d = Math.round((Date.parse(el.getAttribute('data-days-until') + 'T00:00:00Z') - t) / 86400000);
      if (d < 0) return;
      el.textContent = d === 0 ? 'Hoje' : String(d);
      const label = document.querySelector('[data-days-label="' + el.getAttribute('data-days-until') + '"]');
      if (label) label.textContent = d === 0 ? 'é feriado!' : d === 1 ? 'dia' : 'dias';
    });
  })();
</script>
