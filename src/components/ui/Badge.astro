---
import type { HolidayType } from '@/data/schema';
import { HOLIDAY_TYPE_COLORS, HOLIDAY_TYPE_LABELS } from '@/lib/constants';

interface Props {
  type: HolidayType;
  muted?: boolean;
}

const { type, muted = false } = Astro.props;
const colors = HOLIDAY_TYPE_COLORS[type];
const label = HOLIDAY_TYPE_LABELS[type];
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-semibold ring-1 ring-inset',
    colors.bg,
    colors.text,
    'ring-black/5 dark:ring-white/10',
    muted && 'border border-dashed opacity-40',
    !muted && 'badge-glow',
  ]}
>
  <span class:list={['h-1.5 w-1.5 shrink-0 rounded-full', colors.dot]} aria-hidden="true" />
  {label}
</span>
