---
interface Props {
  class?: string;
  padding?: 'sm' | 'md' | 'lg';
}

const { class: className = '', padding = 'md' } = Astro.props;

const paddings = {
  sm: 'p-3',
  md: 'p-4',
  lg: 'p-6',
};
---

<div
  class:list={[
    'rounded-2xl glass-panel transition-shadow duration-200 hover:shadow-card-hover',
    paddings[padding],
    className,
  ]}
>
  <slot />
</div>
