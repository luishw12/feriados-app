---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import Faq from './Faq.astro';
import HolidayList from './HolidayList.astro';
import Icon from './Icon.astro';
import Legend from './Legend.astro';
import NextHoliday from './NextHoliday.astro';
import YearNav from './YearNav.astro';
import { placeOf, type ListModel } from '@/lib/pages';
import { listPageSchemas, type Crumb } from '@/lib/seo/jsonld';
import { describeRule, formatShort } from '@/lib/holidays/rules';
import { currentYear, paths, placeLabel, plural } from '@/lib/site';

interface Props {
  model: ListModel;
}

const { model } = Astro.props;
const { place, year, stats } = model;
const site = Astro.site ?? new URL(Astro.url.origin);

const crumbs: Crumb[] = [{ name: 'Início', path: '/' }];
if (place.state) crumbs.push({ name: place.state.name, path: paths.state(place.state.uf) });
if (place.city && place.state) crumbs.push({ name: place.city.name, path: paths.city(place.state.uf, place.city.slug) });
if (model.type === 'year') crumbs.push({ name: `Feriados ${year}`, path: paths.year(year) });
else if (model.explicitYear) crumbs.push({ name: String(year), path: model.path });

const yearHref = (y: number) =>
  place.city && place.state
    ? paths.city(place.state.uf, place.city.slug, y === currentYear() && !model.explicitYear ? undefined : y)
    : place.state
      ? paths.state(place.state.uf, y)
      : paths.year(y);

const main = model.occurrences.filter((o) => o.kind !== 'comemorativa');
const commemorative = model.occurrences.filter((o) => o.kind === 'comemorativa');
const suggestPlace = place.state
  ? { uf: place.state.uf, ...(place.city ? { ibge: place.city.ibge } : {}), label: placeLabel(place) }
  : undefined;
const local = model.occurrences.filter((o) => o.scope !== 'national');
const showNext = model.next && (!model.explicitYear || Number(model.next.date.slice(0, 4)) === year);
const incomplete = local.filter((o) => o.status !== 'verified').length;
const icsHref = paths.ics(place.state?.uf, place.city?.slug);

const statCards = [
  { value: stats.feriados, label: place.state ? 'Feriados' : 'Feriados nacionais', accent: false },
  { value: stats.onWeekdays, label: 'Caem em dia útil', accent: false },
  { value: stats.bridges, label: 'Dão feriado prolongado', accent: true },
  { value: stats.optional, label: 'Pontos facultativos', accent: false },
];
const hasPast = main.some((o) => o.date < model.today) && main.some((o) => o.date >= model.today);
---

<BaseLayout
  title={model.title}
  description={model.description}
  path={model.path}
  crumbs={crumbs}
  jsonLd={listPageSchemas(site, model)}
  context={{ uf: place.state?.uf, year }}
>
  <div class="container-page pt-6 sm:pt-10">
    {crumbs.length > 1 && <Breadcrumbs crumbs={crumbs} />}

    <section class:list={['grid items-center gap-8 lg:gap-14', showNext && model.next && 'lg:grid-cols-[minmax(0,1fr)_30rem]', crumbs.length > 1 ? 'pt-4 pb-8' : 'pt-4 pb-8 lg:pt-10 lg:pb-12']}>
      <header class="fade-in flex max-w-3xl flex-col gap-4 sm:gap-5">
        <slot name="eyebrow" />
        <h1 class="text-[34px] leading-[1.08] font-bold tracking-tight text-balance sm:text-5xl lg:text-[56px]">{model.h1}</h1>
        <p class="text-[17px] leading-relaxed text-muted text-pretty sm:text-xl">{model.lead}</p>
        <slot name="hero" />
      </header>
      {showNext && model.next && <NextHoliday next={model.next} today={model.today} />}
    </section>

    <dl class="grid grid-cols-2 overflow-hidden rounded-[var(--radius-card)] border border-line bg-surface sm:grid-cols-4">
      {
        statCards.map((s, i) => (
          <div class:list={['px-4 py-4 sm:px-6 sm:py-5', i % 2 === 0 && 'border-r border-line', i < 2 && 'border-b border-line sm:border-b-0', i === 1 && 'sm:border-r']}>
            <dt class="text-sm text-muted sm:text-[15px]">{s.label}</dt>
            <dd class:list={['tabular mt-1 text-[28px] leading-none font-bold sm:text-4xl', s.accent && 'text-brand']}>{s.value}</dd>
          </div>
        ))
      }
    </dl>

    <slot name="before-list" />

    <div class="mt-12 grid gap-10 sm:mt-16 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-12">
      <section aria-labelledby="lista" id="calendario">
        <div class="mb-4 flex flex-wrap items-end justify-between gap-4">
          <div class="flex flex-col gap-3">
            <h2 id="lista" class="text-[27px] font-bold tracking-tight sm:text-[32px]">Calendário {year}</h2>
            <YearNav current={year} href={yearHref} />
          </div>
          {
            hasPast && (
              <div role="group" aria-label="Mostrar" class="grid w-full grid-cols-2 rounded-xl border border-line bg-subtle p-1 sm:w-auto" data-view-toggle>
                <button type="button" data-view="all" aria-pressed="true" class="h-10 rounded-[9px] px-4 text-[15px] font-semibold text-muted aria-pressed:bg-surface aria-pressed:text-fg aria-pressed:shadow-sm">
                  Ano todo
                </button>
                <button type="button" data-view="next" aria-pressed="false" class="h-10 rounded-[9px] px-4 text-[15px] font-semibold text-muted aria-pressed:bg-surface aria-pressed:text-fg aria-pressed:shadow-sm">
                  Só os próximos
                </button>
              </div>
            )
          }
        </div>
        <div class="mb-2 lg:hidden">
          <Legend />
        </div>
        <div id="lista-feriados">
          <HolidayList occurrences={main} today={model.today} place={suggestPlace} />
        </div>

        {
          commemorative.length > 0 && (
            <details class="mt-10 rounded-2xl border border-line bg-surface px-5 py-4">
              <summary class="cursor-pointer font-semibold">Datas comemorativas de {year} (não são feriado)</summary>
              <ul class="mt-3 grid gap-x-6 gap-y-2 text-[15px] sm:grid-cols-2">
                {commemorative.map((o) => (
                  <li class="flex justify-between gap-3">
                    <a href={paths.holiday(o.id, year)} class="hover:underline">
                      {o.name}
                    </a>
                    <span class="tabular text-faint">{formatShort(o.date).slice(0, 5)}</span>
                  </li>
                ))}
              </ul>
            </details>
          )
        }
      </section>

      <aside class="flex flex-col gap-4 lg:sticky lg:top-24 lg:self-start" aria-label="Ajuda e ações">
        <div class="card hidden p-5 lg:block">
          <p class="text-[17px] font-bold">O que significa cada cor</p>
          <Legend variant="card" />
        </div>
        <div class="card flex flex-col gap-3 p-5">
          <p class="text-[17px] font-bold">Leve para sua agenda</p>
          <p class="text-[15px] leading-relaxed text-muted">Os feriados {placeOf(place)} aparecem sozinhos no Google Agenda, Outlook ou iPhone.</p>
          <a href={icsHref} class="btn" rel="nofollow">
            <Icon name="calendarPlus" size={18} /> Adicionar à agenda
          </a>
        </div>
        <div class="flex flex-col gap-3 rounded-[var(--radius-card)] bg-brand-soft p-5">
          <p class="text-[17px] font-bold text-brand-strong">Falta algum feriado?</p>
          <p class="text-[15px] leading-relaxed">
            {incomplete > 0 ? `${plural(incomplete, 'feriado daqui ainda não foi verificado', 'feriados daqui ainda não foram verificados')}. ` : ''}Qualquer pessoa pode sugerir. Toda sugestão é revisada antes de ir ao ar.
          </p>
          <button type="button" class="btn-primary" data-suggest={JSON.stringify({ type: 'new', place: suggestPlace })}>
            <Icon name="plus" size={18} /> Sugerir feriado
          </button>
        </div>
        <nav aria-label="Ferramentas" class="card divide-y divide-line text-[15px]">
          <a href={paths.bridges(year)} class="flex min-h-12 items-center gap-3 px-5 py-3 hover:bg-subtle">
            <Icon name="sparkles" size={18} class="text-muted" /> Feriados prolongados {year}
          </a>
          <a href={paths.businessDays()} class="flex min-h-12 items-center gap-3 px-5 py-3 hover:bg-subtle">
            <Icon name="clock" size={18} class="text-muted" /> Calcular dias úteis
          </a>
          <a href={`${paths.api()}#${place.city ? 'cidade' : place.state ? 'estado' : 'nacional'}`} class="flex min-h-12 items-center gap-3 px-5 py-3 hover:bg-subtle">
            <Icon name="code" size={18} class="text-muted" /> API e incorporar
          </a>
        </nav>
      </aside>
    </div>

    <script is:inline>
      (() => {
        const list = document.getElementById('lista-feriados');
        const buttons = document.querySelectorAll('[data-view-toggle] [data-view]');
        if (!list || !buttons.length) return;
        const set = (view) => {
          list.dataset.view = view;
          buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.view === view)));
          try {
            localStorage.setItem('list-view', view);
          } catch {}
        };
        buttons.forEach((b) => b.addEventListener('click', () => set(b.dataset.view)));
        try {
          if (localStorage.getItem('list-view') === 'next') set('next');
        } catch {}
      })();
    </script>

    {
      local.some((o) => o.kind === 'feriado') && (
        <section aria-labelledby="base-legal" class="mt-16">
          <h2 id="base-legal" class="text-2xl font-bold tracking-tight">
            Feriados {place.city ? 'estaduais e municipais' : 'estaduais'}: regra e base legal
          </h2>
          <div class="mt-4 overflow-x-auto rounded-2xl border border-line bg-surface">
            <table class="w-full text-left text-sm">
              <thead class="border-b border-line text-xs text-faint">
                <tr>
                  <th scope="col" class="px-4 py-3 font-medium">Feriado</th>
                  <th scope="col" class="px-4 py-3 font-medium">Quando</th>
                  <th scope="col" class="px-4 py-3 font-medium">Base legal</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-line">
                {local
                  .filter((o) => o.kind === 'feriado')
                  .map((o) => (
                    <tr>
                      <td class="px-4 py-3 font-medium">
                        <a href={paths.holiday(o.id)} class="hover:underline">
                          {o.name}
                        </a>
                      </td>
                      <td class="px-4 py-3 text-muted">{describeRule(o.rule)}</td>
                      <td class="px-4 py-3 text-muted">{o.legalBasis || <span class="text-faint">A confirmar</span>}</td>
                    </tr>
                  ))}
              </tbody>
            </table>
          </div>
        </section>
      )
    }

    <slot />

    <Faq items={model.faq} />

    {
      place.city && place.state && (
        <script
          is:inline
          data-location={JSON.stringify({ uf: place.state.uf, slug: place.city.slug, name: place.city.name })}
        >
          // Lembra a última cidade vista para sugerir na home e no próximo feriado.
          try {
            localStorage.setItem('location', document.currentScript.dataset.location);
          } catch {}
        </script>
      )
    }

    <p class="mt-10 text-xs text-faint">
      Dados atualizados em {model.updatedAt.toLocaleDateString('pt-BR', { timeZone: 'America/Sao_Paulo' })}. Feriados nacionais conforme a legislação federal;
      estaduais e municipais conforme leis locais, conferidos pela comunidade.
    </p>
  </div>
</BaseLayout>
