---
import Card from '@/components/ui/Card.astro';
import HolidayContributionActions from '@/components/interactive/HolidayContributionActions';
import type { HolidayArticle, HolidayDefinition } from '@/data/schema';
import {
  buildArticleContextFromArticle,
  buildHolidayContextFromDefinition,
} from '@/lib/contributions';

interface Props {
  holidayId: string;
  holidayName: string;
  pageUrl: string;
  definition: HolidayDefinition;
  article: HolidayArticle;
}

const { holidayId, holidayName, pageUrl, definition, article } = Astro.props;

const holidayContext = buildHolidayContextFromDefinition(definition);
const articleContext = buildArticleContextFromArticle(article);
---

<Card padding="md" class="border-emerald-200 dark:border-emerald-900/50">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex items-start gap-3">
      <div
        class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-emerald-100 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300"
        aria-hidden="true"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
          ></path>
        </svg>
      </div>
      <div class="space-y-1">
        <h2 class="text-base font-semibold text-neutral-900 dark:text-neutral-50">
          Ajude a melhorar este feriado
        </h2>
        <p class="text-sm text-neutral-600 dark:text-neutral-400">
          Corrija dados, envie uma nova imagem de banner ou enriqueça o artigo. Suas alterações viram
          um pull request para revisão.
        </p>
      </div>
    </div>
    <HolidayContributionActions
      client:visible
      holidayId={holidayId}
      holidayName={holidayName}
      pageUrl={pageUrl}
      holiday={holidayContext}
      article={articleContext}
    />
  </div>
</Card>
