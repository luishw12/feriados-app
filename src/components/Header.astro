---
import Icon from './Icon.astro';
import { currentYear, paths } from '@/lib/site';

interface Props {
  path: string;
}

const { path } = Astro.props;
const year = currentYear();
const links = [
  { href: paths.year(year), label: `Feriados ${year}` },
  { href: paths.bridges(year), label: 'Prolongados' },
  { href: paths.businessDays(), label: 'Dias úteis' },
  { href: paths.contribute(), label: 'Contribuir' },
];
---

<header class="sticky top-0 z-30 border-b border-line/70 bg-bg/80 backdrop-blur-md">
  <div class="container-page flex h-14 items-center gap-3">
    <a href="/" class="flex items-center gap-2 font-semibold tracking-tight" aria-label="Feriados Brasil — página inicial">
      <svg width="24" height="24" viewBox="0 0 32 32" aria-hidden="true">
        <rect width="32" height="32" rx="8" fill="#047857"></rect>
        <path d="M16 6 27 16 16 26 5 16Z" fill="#facc15"></path>
        <circle cx="16" cy="16" r="5" fill="#1d4ed8"></circle>
      </svg>
      <span>Feriados<span class="text-faint font-normal"> Brasil</span></span>
    </a>

    <nav aria-label="Principal" class="ml-4 hidden items-center gap-1 md:flex">
      {
        links.map((l) => (
          <a
            href={l.href}
            class:list={[
              'rounded-full px-3 py-1.5 text-sm transition-colors hover:bg-subtle hover:text-fg',
              path === l.href ? 'bg-subtle text-fg' : 'text-muted',
            ]}
            aria-current={path === l.href ? 'page' : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-1.5">
      <button
        type="button"
        data-open-search
        class="flex h-9 items-center gap-2 whitespace-nowrap rounded-full border border-line bg-surface px-3 text-sm text-faint transition-colors hover:text-fg sm:w-64"
        aria-label="Buscar cidade, estado ou feriado"
      >
        <Icon name="search" />
        <span class="hidden sm:inline">Buscar cidade ou feriado</span>
        <kbd class="ml-auto hidden rounded border border-line px-1.5 font-mono text-[10px] sm:inline">/</kbd>
      </button>
      <button
        type="button"
        id="theme-toggle"
        class="flex size-9 items-center justify-center rounded-full text-muted transition-colors hover:bg-subtle hover:text-fg"
        aria-label="Alternar tema claro/escuro"
      >
        <Icon name="moon" class="dark:hidden" />
        <Icon name="sun" class="hidden dark:block" />
      </button>
      <details class="relative md:hidden">
        <summary class="flex size-9 cursor-pointer list-none items-center justify-center rounded-full text-muted hover:bg-subtle" aria-label="Menu">
          <Icon name="menu" size={18} />
        </summary>
        <nav aria-label="Menu" class="card absolute right-0 mt-2 flex w-56 flex-col p-2">
          {links.map((l) => <a href={l.href} class="rounded-lg px-3 py-2 text-sm hover:bg-subtle">{l.label}</a>)}
          <a href={paths.api()} class="rounded-lg px-3 py-2 text-sm hover:bg-subtle">API e dados</a>
          <a href={paths.about()} class="rounded-lg px-3 py-2 text-sm hover:bg-subtle">Sobre</a>
        </nav>
      </details>
    </div>
  </div>
</header>

<script is:inline>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark');
    try {
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    } catch {}
  });
</script>
