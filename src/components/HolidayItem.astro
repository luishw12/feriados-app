---
import DateTile from './DateTile.astro';
import Icon from './Icon.astro';
import type { Occurrence } from '@/lib/holidays/resolve';
import { formatDayMonth, weekdayName } from '@/lib/holidays/rules';
import { isBridge } from '@/lib/pages';
import { STATUS_LABEL, paths, tone, typeLabel } from '@/lib/site';

interface Props {
  occ: Occurrence;
  today: string;
  /** Contexto de lugar enviado ao diálogo de sugestão. */
  place?: { uf?: string; ibge?: number; label: string } | undefined;
  showSummary?: boolean;
  /** Destaca o item como o próximo feriado. */
  next?: boolean;
}

const { occ, today, place, showSummary = true, next = false } = Astro.props;
const weekday = weekdayName(occ.date);
const bridge = isBridge(occ);
const past = occ.date < today;
const isToday = occ.date === today;
const t = tone(occ.scope, occ.kind);
const suggest = JSON.stringify({
  holiday: { id: occ.id, name: occ.name, rule: occ.rule, kind: occ.kind, date: occ.date },
  place,
});
const bridgeText =
  bridge?.kind === 'emenda-segunda' ? 'Emenda na segunda' : bridge?.kind === 'emenda-sexta' ? 'Emenda na sexta' : bridge ? '3 dias de folga' : null;
---

<li
  class:list={[
    'group relative flex items-center gap-3.5 rounded-2xl bg-surface p-3 transition-colors sm:gap-[18px] sm:p-3.5 sm:pr-4',
    next ? 'border-2 border-brand shadow-[0_0_0_5px_var(--color-brand-soft)]' : 'border border-line hover:border-line-strong',
  ]}
  data-date={occ.date}
  data-past={past ? '' : undefined}
>
  <DateTile date={occ.date} tone={t} past={past} />
  <div class="min-w-0 flex-1">
    <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1">
      <h4 class:list={['text-base leading-snug font-semibold sm:text-lg', past && 'text-muted']}>
        <a href={paths.holiday(occ.id, Number(occ.date.slice(0, 4)))} class="after:absolute after:inset-0 after:rounded-2xl">{occ.name}</a>
      </h4>
      {isToday && <span class="chip bg-brand text-brand-fg font-bold">Hoje</span>}
      {next && !isToday && <span class="chip bg-brand text-brand-fg font-bold">Próximo</span>}
      {past && <span class="text-[13px] text-faint">já passou</span>}
    </div>
    <p class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1.5 text-sm text-muted sm:text-[15px]">
      <time datetime={occ.date} class="hidden sm:inline">{weekday}, {formatDayMonth(occ.date)}</time>
      <span class="hidden text-line-strong sm:inline" aria-hidden="true">•</span>
      <span class:list={[`tone-${t}`, 'chip tone-badge text-xs font-semibold sm:text-[13px]']}>{typeLabel(occ.scope, occ.kind)}</span>
      {
        bridgeText && !past && (
          <span class="chip bg-brand-soft text-xs font-semibold text-brand-strong sm:text-[13px]">
            <Icon name="sparkles" size={12} /> {bridgeText}
          </span>
        )
      }
      {
        occ.overrideNote && (
          <span class="chip bg-subtle text-xs text-muted sm:text-[13px]">
            <Icon name="clock" size={12} /> {occ.overrideNote}
          </span>
        )
      }
      {
        occ.status !== 'verified' && (
          <span class="chip bg-[var(--color-warn-soft)] text-xs text-[var(--color-warn)] sm:text-[13px]" title="Ainda não conferido com a fonte oficial">
            <Icon name={occ.status === 'incomplete' ? 'help' : 'alert'} size={12} /> {STATUS_LABEL[occ.status]}
          </span>
        )
      }
    </p>
    {showSummary && occ.summary && !past && <p class="mt-1.5 hidden text-sm text-muted line-clamp-2 sm:block">{occ.summary}</p>}
  </div>
  <button
    type="button"
    data-suggest={suggest}
    class="relative z-10 self-start rounded-full p-2 text-faint transition hover:bg-subtle hover:text-fg sm:opacity-0 sm:group-hover:opacity-100 sm:focus:opacity-100"
    aria-label={`Sugerir correção em ${occ.name}`}
    title="Sugerir correção"
  >
    <Icon name="pencil" />
  </button>
</li>
