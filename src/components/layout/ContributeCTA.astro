---
const githubUrl = import.meta.env.PUBLIC_GITHUB_URL ?? 'https://github.com/luishw12/feriados-app';
const contributingUrl = `${githubUrl}/blob/main/CONTRIBUTING.md`;
---

<section
  id="contribuir"
  class="rounded-2xl border border-emerald-200/70 bg-emerald-50/40 p-6 sm:p-8 dark:border-emerald-900/50 dark:bg-emerald-950/20"
  aria-labelledby="contribute-heading"
>
  <div class="grid gap-8 lg:grid-cols-[minmax(0,1.4fr)_minmax(0,0.8fr)] lg:items-end lg:gap-12">
    <div class="space-y-4">
      <p class="text-xs font-medium uppercase tracking-[0.14em] text-emerald-700 dark:text-emerald-400">
        Open source
      </p>
      <h2
        id="contribute-heading"
        class="text-xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-50 sm:text-2xl"
      >
        Contribua com o projeto
      </h2>
      <p class="max-w-xl text-sm leading-relaxed text-neutral-600 dark:text-neutral-400 sm:text-base">
        Corrija datas, adicione feriados municipais ou melhore a interface. Não é preciso saber
        programar para sugerir um feriado que esteja faltando — use o formulário do site.
      </p>
      <ul class="space-y-2 text-sm text-neutral-600 dark:text-neutral-400">
        <li class="flex gap-2">
          <span class="text-emerald-600 dark:text-emerald-400" aria-hidden="true">·</span>
          <span>
            Dados em
            <code class="rounded bg-white/70 px-1.5 py-0.5 text-xs dark:bg-neutral-900/60"
              >src/data/holidays/</code
            >
          </span>
        </li>
        <li class="flex gap-2">
          <span class="text-emerald-600 dark:text-emerald-400" aria-hidden="true">·</span>
          <span>Issue ou pull request no GitHub</span>
        </li>
        <li class="flex gap-2">
          <span class="text-emerald-600 dark:text-emerald-400" aria-hidden="true">·</span>
          <span>Cite a fonte oficial ao alterar feriados</span>
        </li>
      </ul>
    </div>

    <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
      <button
        type="button"
        id="contribute-suggest-holiday-btn"
        class="inline-flex items-center justify-center rounded-full bg-emerald-600 px-5 py-2.5 text-sm font-medium text-white transition-colors duration-150 hover:bg-emerald-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600 dark:bg-emerald-500 dark:text-neutral-950 dark:hover:bg-emerald-400"
      >
        Sugerir feriado
      </button>
      <a
        href={githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center rounded-full border border-neutral-200/90 bg-white/60 px-5 py-2.5 text-sm font-medium text-neutral-700 transition-colors duration-150 hover:border-emerald-300 hover:text-emerald-700 dark:border-neutral-800 dark:bg-neutral-950/40 dark:text-neutral-300 dark:hover:border-emerald-700 dark:hover:text-emerald-300"
      >
        Ver no GitHub
      </a>
      <a
        href={contributingUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center rounded-full px-5 py-2.5 text-sm font-medium text-neutral-600 transition-colors duration-150 hover:text-emerald-700 dark:text-neutral-400 dark:hover:text-emerald-300"
      >
        Guia de contribuição →
      </a>
    </div>
  </div>
</section>

<script is:inline>
  document.getElementById('contribute-suggest-holiday-btn')?.addEventListener('click', function () {
    window.dispatchEvent(
      new CustomEvent('open-contribution', {
        detail: { mode: 'suggest_holiday' },
      }),
    );
  });
</script>
