---
const linkedinUrl = import.meta.env.PUBLIC_LINKEDIN_URL ?? 'https://linkedin.com/in/luishw';
---

<a
  href={linkedinUrl}
  target="_blank"
  rel="noopener noreferrer"
  class="linkedin-fab fixed z-40 flex size-14 items-center justify-center rounded-full bg-[#0A66C2] text-white shadow-[0_8px_28px_-6px_rgba(10,102,194,0.65)] transition-transform duration-200 hover:scale-105 hover:bg-[#004182] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0A66C2] max-md:bottom-[max(1.5rem,env(safe-area-inset-bottom))] max-md:right-[max(1.5rem,env(safe-area-inset-right))] md:bottom-6 md:right-6"
  aria-label="LinkedIn do autor"
  style="--pulse-color: rgba(10, 102, 194, 0.45); --duration: 2s; --distance: 16px; --bg: #0A66C2;"
>
  <span
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 rounded-full animate-pulse"
  ></span>
  <span
    aria-hidden="true"
    class="linkedin-fab-ping pointer-events-none absolute inset-0 rounded-full bg-[#0A66C2]/50"
  ></span>
  <svg class="relative z-10 size-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path
      d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 114.126 0 2.063 2.063 0 01-2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
    ></path>
  </svg>
</a>
