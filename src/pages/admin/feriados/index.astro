---
import AdminLayout from '@/components/admin/AdminLayout.astro';
import PageHeader from '@/components/admin/PageHeader.astro';
import Icon from '@/components/Icon.astro';
import { HOLIDAY_STATUS_CHIP } from '@/lib/admin-ui';
import { and, asc, eq, like, or, type SQL } from 'drizzle-orm';
import { getDb, schema } from '@/lib/db/client';
import { SCOPES, STATUSES } from '@/lib/db/schema';
import { describeRule } from '@/lib/holidays/rules';
import { getStates } from '@/lib/data';
import { SCOPE_LABEL, STATUS_LABEL, tone, typeLabel } from '@/lib/site';

const q = (Astro.url.searchParams.get('q') ?? '').trim().slice(0, 60);
const uf = (Astro.url.searchParams.get('uf') ?? '').toUpperCase();
const scope = Astro.url.searchParams.get('scope') ?? '';
const status = Astro.url.searchParams.get('status') ?? '';
const page = Math.max(1, Number(Astro.url.searchParams.get('p') ?? 1) || 1);
const PAGE = 50;
const states = await getStates();

const where: SQL[] = [];
if (q) where.push(or(like(schema.holidays.name, `%${q}%`), like(schema.holidays.id, `%${q}%`), like(schema.municipalities.name, `%${q}%`))!);
if (/^[A-Z]{2}$/.test(uf)) where.push(eq(schema.holidays.uf, uf));
if ((SCOPES as readonly string[]).includes(scope)) where.push(eq(schema.holidays.scope, scope as (typeof SCOPES)[number]));
if ((STATUSES as readonly string[]).includes(status)) where.push(eq(schema.holidays.status, status as (typeof STATUSES)[number]));

const rows = await getDb()
  .select({ h: schema.holidays, city: schema.municipalities.name })
  .from(schema.holidays)
  .leftJoin(schema.municipalities, eq(schema.holidays.ibge, schema.municipalities.ibge))
  .where(where.length ? and(...where) : undefined)
  .orderBy(asc(schema.holidays.scope), asc(schema.holidays.uf), asc(schema.municipalities.name), asc(schema.holidays.name))
  .limit(PAGE + 1)
  .offset((page - 1) * PAGE);
const hasNext = rows.length > PAGE;
const shown = rows.slice(0, PAGE);
const qs = (p: number) => {
  const params = new URLSearchParams(Astro.url.searchParams);
  params.set('p', String(p));
  return `?${params}`;
};
---

<AdminLayout title="Feriados" active="feriados">
  <PageHeader eyebrow="Dados" title="Feriados" description="Nacionais, estaduais e municipais dos 5.571 municípios.">
    <a href="/admin/feriados/novo/" class="btn-primary"><Icon name="plus" /> Novo feriado</a>
  </PageHeader>

  <form class="card mt-7 grid gap-2 p-2 sm:grid-cols-[1fr_12rem_11rem_11rem_auto]">
    <label class="relative">
      <Icon name="search" class="pointer-events-none absolute top-1/2 left-3 -translate-y-1/2 text-faint" />
      <input name="q" value={q} class="input bg-bg pl-9" placeholder="Nome, ID ou cidade" aria-label="Buscar" type="search" />
    </label>
    <select name="uf" class="input select bg-bg" aria-label="Estado">
      <option value="">Todos os estados</option>
      {states.map((s) => <option value={s.uf} selected={uf === s.uf}>{s.name}</option>)}
    </select>
    <select name="scope" class="input select bg-bg" aria-label="Abrangência">
      <option value="">Toda abrangência</option>
      {SCOPES.map((s) => <option value={s} selected={scope === s}>{SCOPE_LABEL[s]}</option>)}
    </select>
    <select name="status" class="input select bg-bg" aria-label="Status">
      <option value="">Todo status</option>
      {STATUSES.map((s) => <option value={s} selected={status === s}>{STATUS_LABEL[s]}</option>)}
    </select>
    <button class="btn rounded-xl">Filtrar</button>
  </form>

  <div class="card mt-6 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="border-b border-line bg-bg/60 text-left text-xs text-faint">
          <tr>
            <th class="px-5 py-3 font-semibold">Feriado</th>
            <th class="px-5 py-3 font-semibold">Onde</th>
            <th class="px-5 py-3 font-semibold">Data</th>
            <th class="px-5 py-3 font-semibold">Status</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line">
          {
            shown.map(({ h, city }) => (
              <tr class="transition-colors hover:bg-subtle">
                <td class="px-5 py-3">
                  <div class="flex items-center gap-3">
                    <span class:list={[`tone-${tone(h.scope, h.kind)}`, 'tone-dot size-2 shrink-0 rounded-full']} />
                    <div class="min-w-0">
                      <a href={`/admin/feriados/${h.id}/`} class="font-medium hover:underline">
                        {h.name}
                      </a>
                      <span class="block text-xs text-faint">{typeLabel(h.scope, h.kind)}</span>
                    </div>
                  </div>
                </td>
                <td class="px-5 py-3 whitespace-nowrap">{city ? <>{city} <span class="text-faint">· {h.uf}</span></> : (h.uf ?? 'Brasil')}</td>
                <td class="tabular px-5 py-3 whitespace-nowrap">{describeRule(h.rule)}</td>
                <td class="px-5 py-3">
                  <span class:list={['chip px-2.5 py-1', HOLIDAY_STATUS_CHIP[h.status]]}>{STATUS_LABEL[h.status]}</span>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    {shown.length === 0 && <p class="px-5 py-12 text-center text-muted">Nenhum feriado encontrado com esses filtros.</p>}
    <div class="flex items-center justify-between gap-3 border-t border-line px-5 py-3 text-sm text-faint">
      <span class="tabular">{shown.length > 0 ? `Mostrando ${(page - 1) * PAGE + 1}–${(page - 1) * PAGE + shown.length}` : 'Sem resultados'}</span>
      <div class="flex gap-2">
        {page > 1 && <a href={qs(page - 1)} class="btn"><Icon name="chevronLeft" /> Anterior</a>}
        {hasNext && <a href={qs(page + 1)} class="btn">Próxima <Icon name="chevronRight" /></a>}
      </div>
    </div>
  </div>
</AdminLayout>
