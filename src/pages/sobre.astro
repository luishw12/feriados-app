---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AboutAuthorCard from '@/components/about/AboutAuthorCard.astro';
import AboutFeatures from '@/components/about/AboutFeatures.astro';
import AboutLinks from '@/components/about/AboutLinks.astro';
import AboutStats from '@/components/about/AboutStats.astro';
import ContributeCTA from '@/components/layout/ContributeCTA.astro';
import FaqSection from '@/components/guide/FaqSection.astro';
import { getAboutMeta } from '@/lib/seo';
import { buildAboutPageSchema } from '@/lib/schema';
import { getSiteUrl } from '@/lib/site-url';
import { getAboutFaqItems, ABOUT_USEFUL_LINKS, ABOUT_FEATURES } from '@/lib/about-content';
import {
  getAllStates,
  getAllMunicipalities,
  getAllHolidayDefinitions,
} from '@/lib/holidays';
import { getAllArticles } from '@/lib/articles';
import { GUIDE_PAGES } from '@/lib/search-intents';

const meta = getAboutMeta();
const authorName = import.meta.env.PUBLIC_AUTHOR_NAME ?? 'Luís Henrique Wendt';
const linkedinUrl = import.meta.env.PUBLIC_LINKEDIN_URL ?? 'https://linkedin.com/in/luishw';
const githubUrl = import.meta.env.PUBLIC_GITHUB_URL ?? 'https://github.com/luishw12/feriados-app';
const siteUrl = getSiteUrl(Astro.site);
const faqItems = getAboutFaqItems(siteUrl, githubUrl);
const jsonLd = buildAboutPageSchema(siteUrl, authorName, meta.title, meta.description, faqItems);

const stats = [
  { value: getAllStates().length, label: 'Estados brasileiros' },
  { value: getAllMunicipalities().length, label: 'Cidades catalogadas' },
  { value: getAllHolidayDefinitions().length, label: 'Feriados no catálogo' },
  { value: getAllArticles().length, label: 'Artigos educativos' },
];

const usefulLinks = [
  ...ABOUT_USEFUL_LINKS,
  {
    href: githubUrl,
    title: 'Repositório MIT',
    description: 'Código-fonte, issues e pull requests no GitHub.',
    external: true,
  },
];
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  jsonLd={jsonLd}
>
  <div class="page-shell">
    <nav class="mb-10 text-sm text-neutral-500 dark:text-neutral-400" aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2">
        <li>
          <a
            href="/"
            class="transition-colors duration-150 hover:text-emerald-600 dark:hover:text-emerald-400"
          >
            Início
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li><span class="text-neutral-700 dark:text-neutral-300">Sobre</span></li>
      </ol>
    </nav>

    <header
      class="mb-14 grid w-full gap-8 sm:mb-16 sm:gap-10 lg:mb-20 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,0.9fr)] lg:items-end lg:gap-14"
    >
      <div class="w-full min-w-0 space-y-5 sm:space-y-6">
        <p class="text-sm font-medium tracking-wide text-emerald-700 dark:text-emerald-400">
          Projeto open source
        </p>
        <h1
          class="max-w-xl text-balance text-3xl font-semibold tracking-tight text-neutral-900 sm:text-4xl sm:leading-tight dark:text-neutral-50"
        >
          Sobre o Feriados Brasil: calendário estático e gratuito
        </h1>
        <p class="max-w-xl text-base leading-relaxed text-neutral-600 sm:text-lg dark:text-neutral-400">
          Feriados nacionais, estaduais e municipais versionados no repositório. O site é gerado
          estaticamente — sem backend, sem banco e sem API em runtime.
        </p>
        <p class="max-w-xl text-sm leading-relaxed text-neutral-500 dark:text-neutral-400">
          Consulte por localidade, planeje emendas e leia guias objetivos. Performance e SEO de alto
          nível, com código aberto sob licença MIT.
        </p>
        <div class="flex flex-wrap items-center gap-3 pt-1">
          <a
            href="/"
            class="inline-flex items-center rounded-full bg-emerald-600 px-5 py-2.5 text-sm font-medium text-white transition-colors duration-150 hover:bg-emerald-700 dark:bg-emerald-500 dark:text-neutral-950 dark:hover:bg-emerald-400"
          >
            Abrir calendário
          </a>
          <a
            href="/guia/"
            class="inline-flex items-center rounded-full px-4 py-2.5 text-sm font-medium text-neutral-700 transition-colors duration-150 hover:text-emerald-700 dark:text-neutral-300 dark:hover:text-emerald-300"
          >
            Ver guias
            <span class="ml-1.5 text-neutral-400" aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <AboutStats stats={stats} />
    </header>

    <div class="mb-16 lg:mb-20">
      <AboutFeatures items={ABOUT_FEATURES} />
    </div>

    <div class="mb-16 lg:mb-20">
      <AboutAuthorCard
        authorName={authorName}
        linkedinUrl={linkedinUrl}
        githubUrl={githubUrl}
      />
    </div>

    <div class="mb-16 lg:mb-20">
      <AboutLinks items={usefulLinks} />
    </div>

    <nav class="mb-16 lg:mb-20" aria-label="Guias de feriados">
      <h2 class="mb-4 text-xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-50">
        Guias para consulta rápida
      </h2>
      <ul class="flex flex-wrap gap-2">
        {
          GUIDE_PAGES.map((guide) => (
            <li>
              <a
                href={`/guia/${guide.slug}/`}
                class="inline-flex rounded-lg border border-neutral-200 px-3 py-1.5 text-sm text-neutral-700 transition-colors duration-150 hover:border-emerald-300 hover:text-emerald-700 dark:border-neutral-700 dark:text-neutral-200 dark:hover:border-emerald-700"
              >
                {guide.title}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="mb-16 lg:mb-20">
      <ContributeCTA />
    </div>

    <div class="mb-4 max-w-3xl">
      <FaqSection items={faqItems} title="Perguntas sobre o projeto" />
    </div>
  </div>
</BaseLayout>
