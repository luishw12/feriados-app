---
import BaseLayout from '@/layouts/BaseLayout.astro';
import GuideIndex from '@/components/guide/GuideIndex.astro';
import GuideYearSnapshot from '@/components/guide/GuideYearSnapshot.astro';
import FaqSection from '@/components/guide/FaqSection.astro';
import { getGuideHubMeta } from '@/lib/seo';
import { buildGuideHubSchema } from '@/lib/schema';
import { getSiteUrl } from '@/lib/site-url';
import { GUIDE_PAGES } from '@/lib/search-intents';
import { getAllSearchFaqItems } from '@/lib/search-intents';
import { buildNationalYearInsights } from '@/lib/holiday-insights';
import { formatHolidayDate } from '@/lib/constants';

const year = new Date().getFullYear();
const meta = getGuideHubMeta(year);
const siteUrl = getSiteUrl(Astro.site);
const insights = buildNationalYearInsights(year);
const faqItems = getAllSearchFaqItems(year, siteUrl).slice(0, 8);

const guideDescriptions: Record<(typeof GUIDE_PAGES)[number]['slug'], string> = {
  'calendario-feriados': `Lista mês a mês dos feriados nacionais de ${year}, com links para estados.`,
  'feriados-nacionais': `Os ${insights.stats.mandatoryTotal} feriados obrigatórios do calendário federal, com datas.`,
  'feriados-dias-uteis': `${insights.stats.mandatoryWeekdayCount} feriados caem de segunda a sexta — e quais ficam no fim de semana.`,
  'feriados-facultativos': `Pontos facultativos federais: o que muda no trabalho e no serviço público.`,
  'emendas-e-feriados-prolongados': `${insights.stats.bridgeCount} datas em terça ou quinta com potencial de feriadão.`,
  'proximo-feriado': insights.nextHoliday
    ? `Agora: ${insights.nextHoliday.name}, em ${formatHolidayDate(insights.nextHoliday.resolvedDate)}.`
    : `Consulta rápida do próximo feriado nacional a partir de hoje.`,
  'feriados-moveis': 'Carnaval, Sexta-feira Santa, Páscoa e Corpus Christi — datas que mudam todo ano.',
};

const guideLinks = GUIDE_PAGES.map((guide) => ({
  href: `/guia/${guide.slug}/`,
  title: guide.title,
  description: guideDescriptions[guide.slug],
}));

const guideSchemaItems = GUIDE_PAGES.map((guide) => ({
  name: guide.title,
  url: `${siteUrl}/guia/${guide.slug}/`,
  description: guideDescriptions[guide.slug],
}));

const jsonLd = buildGuideHubSchema(
  siteUrl,
  meta.title,
  meta.description,
  faqItems,
  guideSchemaItems,
);

const hubStats = [
  { value: insights.stats.mandatoryTotal, label: 'Nacionais obrigatórios' },
  { value: insights.stats.mandatoryWeekdayCount, label: 'Em dias úteis' },
  { value: insights.stats.optionalTotal, label: 'Facultativos' },
  { value: insights.stats.bridgeCount, label: 'Com potencial de emenda' },
];

const featuredHref = '/guia/calendario-feriados/';
---

<BaseLayout title={meta.title} description={meta.description} canonical={meta.canonical} jsonLd={jsonLd}>
  <div class="page-shell">
    <nav class="mb-10 text-sm text-neutral-500 dark:text-neutral-400" aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2">
        <li>
          <a href="/" class="transition-colors duration-150 hover:text-emerald-600 dark:hover:text-emerald-400">
            Início
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li><span class="text-neutral-700 dark:text-neutral-300">Guias</span></li>
      </ol>
    </nav>

    <header class="mb-14 grid w-full gap-8 sm:mb-16 sm:gap-10 lg:mb-20 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,0.9fr)] lg:items-end lg:gap-14">
      <div class="w-full min-w-0 space-y-5 sm:space-y-6">
        <p class="text-sm font-medium tracking-wide text-emerald-700 dark:text-emerald-400">
          Consulta rápida · {year}
        </p>
        <h1 class="max-w-xl text-balance text-3xl font-semibold tracking-tight text-neutral-900 sm:text-4xl sm:leading-tight dark:text-neutral-50">
          Guias de feriados {year}: datas, regras e contexto
        </h1>
        <p class="max-w-xl text-base leading-relaxed text-neutral-600 sm:text-lg dark:text-neutral-400">
          Um índice objetivo para achar o próximo feriado, saber o que é facultativo, planejar
          emendas ou revisar o calendário nacional de {year} — sem enrolação.
        </p>
        <div class="flex flex-wrap items-center gap-3 pt-1">
          <a
            href={featuredHref}
            class="inline-flex items-center rounded-full bg-emerald-600 px-5 py-2.5 text-sm font-medium text-white transition-colors duration-150 hover:bg-emerald-700 dark:bg-emerald-500 dark:hover:bg-emerald-400 dark:hover:text-neutral-950"
          >
            Abrir calendário {year}
          </a>
          {
            insights.nextHoliday && (
              <a
                href="/guia/proximo-feriado/"
                class="inline-flex items-center rounded-full px-4 py-2.5 text-sm font-medium text-neutral-700 transition-colors duration-150 hover:text-emerald-700 dark:text-neutral-300 dark:hover:text-emerald-300"
              >
                Próximo: {insights.nextHoliday.name}
                <span class="ml-1.5 text-neutral-400" aria-hidden="true">→</span>
              </a>
            )
          }
        </div>
      </div>

      <GuideYearSnapshot year={year} stats={hubStats} />
    </header>

    <div class="mb-16 lg:mb-20">
      <GuideIndex items={guideLinks} year={year} />
    </div>

    <p class="mb-16 text-sm text-neutral-500 dark:text-neutral-400 lg:mb-20">
      Índice para assistentes de IA:
      <a href="/llms.txt" class="text-emerald-700 hover:underline dark:text-emerald-400">/llms.txt</a>
      ·
      <a href="/sobre/" class="text-emerald-700 hover:underline dark:text-emerald-400">Sobre o projeto</a>
    </p>

    <div class="mb-4 max-w-3xl">
      <FaqSection items={faqItems} />
    </div>
  </div>
</BaseLayout>
