---
import ListPage from '@/components/ListPage.astro';
import StatesGrid from '@/components/StatesGrid.astro';
import Icon from '@/components/Icon.astro';
import { cachePage } from '@/lib/cache';
import { getStates } from '@/lib/data';
import { buildListModel } from '@/lib/pages';
import { currentYear, paths } from '@/lib/site';

const year = currentYear();
const [model, states] = await Promise.all([buildListModel({ type: 'home', year, explicitYear: false }), getStates()]);
cachePage(Astro, model.tags, { lastModified: model.updatedAt });
---

<ListPage model={model}>
  <div slot="before-list" class="mt-6">
    <div class="card flex flex-col gap-4 p-5 sm:flex-row sm:items-center sm:justify-between" id="minha-cidade">
      <div>
        <p class="font-medium">Veja os feriados da sua cidade</p>
        <p class="text-sm text-muted">Nacionais, estaduais e municipais dos 5.571 municípios, com emendas.</p>
      </div>
      <div class="flex flex-wrap gap-2">
        <button type="button" data-open-search class="btn-primary"><Icon name="search" /> Buscar cidade</button>
        <a href="#" id="geo-suggestion" class="btn hidden"><Icon name="mapPin" /> <span></span></a>
      </div>
    </div>
  </div>

  <StatesGrid states={states} />

  <section class="mt-16 grid gap-4 sm:grid-cols-3" aria-label="Ferramentas">
    <a href={paths.bridges(year)} class="card p-5 hover:border-line-strong">
      <Icon name="sparkles" size={20} />
      <p class="mt-3 font-medium">Feriados prolongados {year}</p>
      <p class="mt-1 text-sm text-muted">Quais feriados caem perto do fim de semana e quando dá para emendar.</p>
    </a>
    <a href={paths.businessDays()} class="card p-5 hover:border-line-strong">
      <Icon name="clock" size={20} />
      <p class="mt-3 font-medium">Calculadora de dias úteis</p>
      <p class="mt-1 text-sm text-muted">Conte dias úteis entre duas datas considerando os feriados da sua cidade.</p>
    </a>
    <a href={paths.api()} class="card p-5 hover:border-line-strong">
      <Icon name="code" size={20} />
      <p class="mt-3 font-medium">API gratuita e dados abertos</p>
      <p class="mt-1 text-sm text-muted">Use os feriados no seu sistema, planilha ou site — sem cadastro.</p>
    </a>
  </section>
</ListPage>

<script>
  import { suggestLocation } from '@/lib/client/location';
  suggestLocation();
</script>
