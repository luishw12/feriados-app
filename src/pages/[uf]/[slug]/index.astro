---
/**
 * /sp/campinas/ → página da cidade
 * /sp/2027/     → página do estado num ano específico
 */
import ListPage from '@/components/ListPage.astro';
import CityList from '@/components/CityList.astro';
import NearbyCities from '@/components/NearbyCities.astro';
import { cachePage } from '@/lib/cache';
import { getCity, getState } from '@/lib/data';
import { buildListModel } from '@/lib/pages';
import { currentYear, isValidYear } from '@/lib/site';

const { uf = '', slug = '' } = Astro.params;
const state = /^[a-z]{2}$/.test(uf) ? await getState(uf) : null;
if (!state) return Astro.rewrite('/404/');

const isYear = /^\d{4}$/.test(slug);
if (isYear && !isValidYear(slug)) return Astro.rewrite('/404/');
const city = isYear ? null : await getCity(state.uf, slug);
if (!isYear && !city) return Astro.rewrite('/404/');

const model = await buildListModel({
  type: city ? 'city' : 'state',
  year: isYear ? Number(slug) : currentYear(),
  explicitYear: isYear,
  state,
  city,
});
cachePage(Astro, model.tags, { lastModified: model.updatedAt });
---

<ListPage model={model}>
  {city ? <NearbyCities state={state} cities={model.nearby} /> : <CityList state={state} cities={model.cities} year={model.year} />}
</ListPage>
