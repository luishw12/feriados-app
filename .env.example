# Tudo é opcional no desenvolvimento local: sem essas variáveis o site usa um
# SQLite em arquivo (.data/feriados.db), o Turnstile em modo de teste e os
# e-mails são apenas impressos no console.

PUBLIC_SITE_URL=https://feriados.luishw.com.br

# Banco de dados (Turso / libSQL) — https://turso.tech
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Login do painel /admin (GitHub OAuth App) — callback: {site}/admin/auth/callback/
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Logins do GitHub que podem moderar, separados por vírgula
ADMIN_GITHUB_LOGINS=luishw12
# Segredo aleatório (32+ caracteres) para assinar cookies e hashes de IP
SESSION_SECRET=

# Anti-spam (Cloudflare Turnstile)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# E-mail de aviso de novas sugestões (Resend)
RESEND_API_KEY=
ADMIN_EMAIL=
EMAIL_FROM=Feriados Brasil <feriados@luishw.com.br>

# Google Analytics 4 (opcional; só carrega após consentimento no banner de cookies)
PUBLIC_GA_MEASUREMENT_ID=

# IndexNow (Bing/Yandex) — qualquer string hexadecimal de 32 caracteres
INDEXNOW_KEY=
